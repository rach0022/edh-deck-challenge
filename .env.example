# ─── Docker Compose — Local Development ─────────────────────────────────────
# Copy this file to `.env` (same directory as docker-compose.yml) and adjust.
# Docker Compose automatically loads `.env` from this directory.

# ─── Host Port ───────────────────────────────────────────────────────────────
# The port on your machine that maps to the app inside the container.
# Browse to http://localhost:${APP_PORT}. Defaults to 3000 if unset.
# You can also override it inline: APP_PORT=8080 docker compose up -d
APP_PORT=3000

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Cache Driver ─────────────────────────────────────────────────────────────
# Which cache backend to use: 'upstash', 'redis', or 'memory'
# If not set, auto-detects based on which credentials are configured:
#   - UPSTASH_REDIS_REST_URL + TOKEN set → upstash
#   - REDIS_URL set → redis
#   - Neither → memory (in-process, resets on restart)
CACHE_DRIVER=

# ─── Local Redis (Docker) ────────────────────────────────────────────────────
# Standard Redis connection URL for local development via ioredis (TCP).
# Start Redis: docker run -d --name redis-local -p 6379:6379 redis:alpine
REDIS_URL=redis://localhost:6379

# ─── Upstash Redis (free tier: https://upstash.com) ──────────────────────────
# Create a free Redis database at https://console.upstash.com
# Copy the REST URL and token from the database details page
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cache Settings ──────────────────────────────────────────────────────────
# How long to cache Moxfield responses (in seconds)
# Default: 900 (15 minutes)
CACHE_TTL_SECONDS=900

# ─── Moxfield ────────────────────────────────────────────────────────────────
# Base URL for Moxfield API (shouldn't need to change)
MOXFIELD_BASE_URL=https://api2.moxfield.com/v2

# Timeout for Puppeteer operations (ms)
PUPPETEER_TIMEOUT_MS=60000

# Run browser in headless mode (set to "false" for debugging)
PUPPETEER_HEADLESS=true

# ─── Scryfall ────────────────────────────────────────────────────────────────
# Base URL for the Scryfall API (shouldn't need to change)
SCRYFALL_BASE_URL=https://api.scryfall.com

# Timeout for Scryfall/autocomplete requests (ms)
SCRYFALL_TIMEOUT_MS=5000

# ─── EDHREC ──────────────────────────────────────────────────────────────────
# Base URL for the EDHREC JSON endpoints (shouldn't need to change)
EDHREC_BASE_URL=https://json.edhrec.com

# Timeout for EDHREC fetches (ms)
EDHREC_TIMEOUT_MS=30000
