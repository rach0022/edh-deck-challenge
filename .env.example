# ─── Docker Compose — Local Development ─────────────────────────────────────
# Copy this file to `.env` (same directory as docker-compose.yml) and adjust.
# Docker Compose automatically loads `.env` from this directory.

# ─── Host Port ───────────────────────────────────────────────────────────────
# The port on your machine that maps to the app inside the container.
# Browse to http://localhost:${APP_PORT}. Defaults to 3000 if unset.
# You can also override it inline: APP_PORT=8080 docker compose up -d
APP_PORT=3000
