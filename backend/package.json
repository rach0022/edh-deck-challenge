  "dependencies": {
    "@hono/node-server": "1.14.1",
    "@upstash/redis": "1.34.8",
    "hono": "4.7.10",
    "ioredis": "^5.6.1",
    "puppeteer": "25.8.0"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
