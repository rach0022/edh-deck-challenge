{
  "name": "edh-deck-challenge",
  "version": "1.0.0",
  "description": "EDH deck web application (Hono SSR + API) with the 32 Deck Challenge CLI relocated under utils/",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/public dist/data && cp -r src/public/. dist/public/ && cp -r src/data/. dist/data/",
    "build:cedh": "tsx src/scripts/build-cedh-corpus.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "utils": "tsx utils/src/index.ts",
    "utils:build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rach0022/edh-deck-challenge.git"
  },
  "keywords": [
    "edh",
    "commander",
    "mtg",
    "moxfield",
    "hono"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rach0022/edh-deck-challenge/issues"
  },
  "homepage": "https://github.com/rach0022/edh-deck-challenge#readme",
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@upstash/redis": "1.34.8",
    "hono": "4.13.5",
    "ioredis": "^5.6.1",
    "puppeteer": "25.8.0"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "fast-check": "^4.9.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "puppeteer@25.8.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true
  }
}
